# Local development
EMAIL_PROVIDER=mailpit
MYSQL_ROOT_PASSWORD=replace_with_secure_root_password
DB_PASSWORD=replace_with_secure_db_password
JWT_SECRET=replace_with_a_long_random_secret
# Amazon SES (uncomment and set after verifying the sender identity)
# EMAIL_PROVIDER=ses
# AWS_REGION=us-east-1
# SES_FROM_EMAIL=verified-sender@your-domain.com

# Never commit AWS access keys. Use an IAM role on AWS hosting.
